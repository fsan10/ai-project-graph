{
  "name": "ai-project-graph",
  "version": "0.1.0",
  "description": "以软件架构为中心组织 AI 编程项目、上下文、任务、会话与代码证据的可视化工作台",
  "license": "MIT",
  "homepage": "https://ai-project-graph.jz1234da.chatgpt.site",
  "keywords": [
    "ai",
    "codex",
    "software-architecture",
    "project-management",
    "task-management",
    "knowledge-graph",
    "developer-tools",
    "react",
    "typescript"
  ],
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite --config vite.local.config.mjs",
    "dev:site": "vite",
    "build:local": "vite build --config vite.local.config.mjs",
    "test:workspace": "node --test tests/workspace.test.mjs",
    "codex": "node scripts/codex-project-graph-injector.mjs --port 9231 --watch --open",
    "codex:inject": "node scripts/codex-project-graph-injector.mjs --port 9231 --watch",
    "build": "vite build --config vite.local.config.mjs",
    "build:site": "bash scripts/build-verified.sh",
    "start": "vite --config vite.local.config.mjs",
    "test": "npm run typecheck && node --test tests/workspace.test.mjs tests/domain.test.mjs tests/canvas.test.mjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
